@model Producto
@{ ViewData["Title"] = "Añadir producto"; }
<section class="pagina">
    <h1 class="titulo-pagina">AÑADIR PRODUCTO</h1>
    <form asp-action="Crear" method="post" class="formulario">
        <div asp-validation-summary="ModelOnly" class="error"></div>

        <label asp-for="Nombre">Nombre</label>
        <input asp-for="Nombre" />
        <span asp-validation-for="Nombre" class="error"></span>

        <label asp-for="Descripcion">Descripción</label>
        <input asp-for="Descripcion" />

        <label asp-for="Precio">Precio</label>
        <input asp-for="Precio" type="number" step="0.01" />
        <span asp-validation-for="Precio" class="error"></span>

        <label asp-for="PrecioRebaja">Precio en rebaja (opcional)</label>
        <input asp-for="PrecioRebaja" type="number" step="0.01" />

        <label asp-for="IdCategoria">Categoría</label>
        <select asp-for="IdCategoria" asp-items="(SelectList)ViewBag.Categorias"></select>

        <label asp-for="Tipo">Tipo de prenda</label>
        <select asp-for="Tipo" asp-items="(SelectList)ViewBag.Tipos"></select>

        <label asp-for="Existencia">Existencia</label>
        <input asp-for="Existencia" type="number" />

        <label asp-for="ImagenUrl">Ruta de la imagen (ej. /img/polo.jpg)</label>
        <input asp-for="ImagenUrl" />

        <label class="check"><input asp-for="EsMasVendido" /> Mostrar en “Lo más vendido”</label>

        <button type="submit" class="btn-anadir">Guardar producto</button>
        <a asp-controller="Home" asp-action="Index">Cancelar</a>
    </form>
</section>
