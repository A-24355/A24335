@model Producto
@{
    var enRebaja = Model.PrecioRebaja != null;
    var slug = Model.Categoria?.Slug ?? "";
}
<article class="producto">
    <div class="producto-img"
         style="@(string.IsNullOrEmpty(Model.ImagenUrl) ? "" : $"background-image:url('{Model.ImagenUrl}')")">
    </div>
    <div class="producto-info">
        <p class="precio">
            @if (enRebaja)
            {
                <span>$@Model.PrecioRebaja?.ToString("N2")</span>
                <s>$@Model.Precio.ToString("N2")</s>
            }
            else
            {
                <span>$@Model.Precio.ToString("N2")</span>
            }
        </p>
        <h3>@Model.Nombre</h3>
        <p class="desc">@Model.Descripcion</p>
        @if (Model.Categoria != null)
        {
            <a class="cat" asp-controller="Categoria" asp-action="Ver" asp-route-slug="@slug">@Model.Categoria.Nombre.ToUpper()</a>
        }
<form asp-controller="Productos" asp-action="Eliminar" asp-route-id="@Model.Id" method="post"
      onsubmit="return confirm('¿Eliminar &quot;@Model.Nombre&quot;? Esta acción no se puede deshacer.');">
    <button type="submit" class="btn-eliminar">Eliminar</button>
</form>
    </div>

    
</article>
